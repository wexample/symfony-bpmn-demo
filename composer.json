{
  "name": "wexample/symfony-bpmn-demo",
  "version": "2.1.8",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyBpmnDemo\\": "src/"
    }
  },
  "description": "Demo pages of symfony-bpmn: the examples of php-bpmn, on the teams of symfony-user-demo",
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyBpmnDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.1.0",
    "wexample/symfony-design-system": ">=39.0.3",
    "wexample/php-bpmn": ">=2.0.2",
    "wexample/symfony-bpmn": ">=3.0.5",
    "wexample/symfony-bpmn-ds": ">=2.0.8",
    "wexample/symfony-user": ">=14.0.4",
    "wexample/symfony-user-demo": ">=8.0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}